# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit real keys.

# OpenRouter key, used for the Jev decision model and the other
# Decisions API models. See https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: explicit Imagenette resolution/root.
# IMAGENETTE_VERSION=320
# IMAGENETTE_ROOT=data/imagenette2-320
